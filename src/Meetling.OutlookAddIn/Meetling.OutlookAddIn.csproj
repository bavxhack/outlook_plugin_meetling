<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework><LangVersion>latest</LangVersion><Nullable>enable</Nullable>
    <OutputType>Library</OutputType><Platforms>AnyCPU;x86;x64</Platforms><PlatformTarget>AnyCPU</PlatformTarget>
    <RootNamespace>Meetling.OutlookAddIn</RootNamespace><AssemblyName>Meetling.OutlookAddIn</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo><UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)'=='x86'"><PlatformTarget>x86</PlatformTarget><OutputPath>bin\x86\$(Configuration)\</OutputPath></PropertyGroup>
  <PropertyGroup Condition="'$(Platform)'=='x64'"><PlatformTarget>x64</PlatformTarget><OutputPath>bin\x64\$(Configuration)\</OutputPath></PropertyGroup>
  <ItemGroup><ProjectReference Include="..\Meetling.Core\Meetling.Core.csproj" /></ItemGroup>
  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Security" />
    <PackageReference Include="Microsoft.Office.Interop.Outlook" Version="15.0.4797.1004">
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>true</Private>
    </PackageReference>
  </ItemGroup>
</Project>

