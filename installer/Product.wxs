<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <?if $(var.Platform) = x64 ?>
    <?define Win64 = yes ?>
  <?else?>
    <?define Win64 = no ?>
  <?endif?>
  <Product Id="*" Name="Meetling Outlook Add-in" Language="1031" Version="$(var.ProductVersion)" Manufacturer="Meetling" UpgradeCode="9B30E685-B217-4B68-A511-53304A097FD7">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perUser" Platform="$(var.Platform)" />
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="Eine neuere Version ist bereits installiert."/><MediaTemplate EmbedCab="yes"/>
    <Directory Id="TARGETDIR" Name="SourceDir"><Directory Id="LocalAppDataFolder"><Directory Id="CompanyDir" Name="Meetling"><Directory Id="AddInRoot" Name="OutlookAddIn"><Directory Id="INSTALLFOLDER" Name="$(var.Platform)">
      <Component Id="AddInFiles" Guid="*" Win64="$(var.Win64)">
        <File Id="AddInDll" Source="$(var.SourceDir)\Meetling.OutlookAddIn.dll"/>
        <File Id="CoreDll" Source="$(var.SourceDir)\Meetling.Core.dll"/>
        <File Id="MicrosoftOfficeInteropOutlookdll" Source="$(var.SourceDir)\Microsoft.Office.Interop.Outlook.dll"/>
        <File Id="NewtonsoftJsondll" Source="$(var.SourceDir)\Newtonsoft.Json.dll"/>
        <File Id="MicrosoftWebWebView2Coredll" Source="$(var.SourceDir)\Microsoft.Web.WebView2.Core.dll"/>
        <File Id="MicrosoftWebWebView2WinFormsdll" Source="$(var.SourceDir)\Microsoft.Web.WebView2.WinForms.dll"/>
        <File Id="WebView2Loaderdll" Source="$(var.SourceDir)\WebView2Loader.dll"/>
        <RegistryKey Root="HKCU" Key="Software\Microsoft\Office\Outlook\Addins\Meetling.OutlookAddIn"><RegistryValue Name="FriendlyName" Type="string" Value="Meetling-Konferenzen"/><RegistryValue Name="Description" Type="string" Value="Erstellt Meetling-Konferenzen aus Outlook-Terminen."/><RegistryValue Name="LoadBehavior" Type="integer" Value="3" KeyPath="yes"/></RegistryKey>
        <RegistryKey Root="HKCU" Key="Software\Classes\Meetling.OutlookAddIn"><RegistryValue Type="string" Value="Meetling Outlook Add-in"/></RegistryKey>
        <RegistryKey Root="HKCU" Key="Software\Classes\Meetling.OutlookAddIn\CLSID"><RegistryValue Type="string" Value="{4BB84EF2-9D83-4710-BDBA-7CBFD6939B48}"/></RegistryKey>
        <RegistryKey Root="HKCU" Key="Software\Classes\CLSID\{4BB84EF2-9D83-4710-BDBA-7CBFD6939B48}"><RegistryValue Type="string" Value="Meetling.OutlookAddIn.MeetlingAddIn"/></RegistryKey>
        <RegistryKey Root="HKCU" Key="Software\Classes\CLSID\{4BB84EF2-9D83-4710-BDBA-7CBFD6939B48}\InprocServer32"><RegistryValue Type="string" Value="mscoree.dll"/><RegistryValue Name="ThreadingModel" Type="string" Value="Both"/><RegistryValue Name="Class" Type="string" Value="Meetling.OutlookAddIn.MeetlingAddIn"/><RegistryValue Name="Assembly" Type="string" Value="Meetling.OutlookAddIn, Version=$(var.AssemblyVersion), Culture=neutral, PublicKeyToken=null"/><RegistryValue Name="RuntimeVersion" Type="string" Value="v4.0.30319"/><RegistryValue Name="CodeBase" Type="string" Value="file:///[#AddInDll]"/></RegistryKey>
        <RegistryKey Root="HKCU" Key="Software\Classes\CLSID\{4BB84EF2-9D83-4710-BDBA-7CBFD6939B48}\ProgId"><RegistryValue Type="string" Value="Meetling.OutlookAddIn"/></RegistryKey>
        <RemoveFolder Id="RemoveInstallFolder" On="uninstall"/>
        <RemoveFolder Id="RemoveAddInRoot" Directory="AddInRoot" On="uninstall"/>
        <RemoveFolder Id="RemoveCompanyDir" Directory="CompanyDir" On="uninstall"/>
      </Component>
    </Directory></Directory></Directory></Directory></Directory>
    <Property Id="NETFRAMEWORK48">
      <RegistrySearch Id="FrameworkRelease" Root="HKLM" Key="SOFTWARE\Microsoft\NET Framework Setup\NDP\v4\Full" Name="Release" Type="raw" Win64="no"/>
    </Property>
    <Condition Message="Bitte zuerst .NET Framework 4.8 installieren.">Installed OR NETFRAMEWORK48 &gt;= "#528040"</Condition>
    <Feature Id="Complete" Title="Meetling Outlook Add-in" Level="1"><ComponentRef Id="AddInFiles"/></Feature>
  </Product>
</Wix>
